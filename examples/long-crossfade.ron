// The built-in default, as a file. 16 bars (64 beats) equal-power.
// Usage: --automation examples/long-crossfade.ron
TransitionSpec(
    name: "LongCrossfade",
    beats: 64,
    curves: [
        TransitionCurve(
            role: Outgoing,
            address: Gain,
            from: 1.0,
            to: 0.0,
            shape: EqualPower,
        ),
        TransitionCurve(
            role: Incoming,
            address: Gain,
            from: 0.0,
            to: 1.0,
            shape: EqualPower,
        ),
    ],
)
